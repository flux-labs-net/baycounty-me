{
  "outputDirectory": "site/public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/mcp.js": {
      "includeFiles": "data/campaign/vendor_matches.json"
    }
  },
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/alerts-run",
      "schedule": "40 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/alerts/manage",
      "destination": "/api/manage"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1?path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
