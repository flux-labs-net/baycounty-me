{
  "outputDirectory": "site/public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/mcp.js": {
      "includeFiles": "data/campaign/vendor_matches.json"
    },
    "api/finance.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "maxDuration": 60,
      "includeFiles": "data/civic/official_contacts.json"
    }
  },
  "crons": [
    {
      "path": "/api/digest",
      "schedule": "0 13 * * 1"
    },
    {
      "path": "/api/alerts-run",
      "schedule": "40 13 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/public-money/cra-network",
      "destination": "/connections",
      "permanent": true
    },
    {
      "source": "/public-money/campaign-money",
      "destination": "/connections/campaign-gifts",
      "permanent": true
    },
    {
      "source": "/public-money/money-map",
      "destination": "/connections/money-map",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/profile/:kind/:id",
      "destination": "/profile"
    },
    {
      "source": "/alerts/manage",
      "destination": "/api/manage"
    },
    {
      "source": "/api/v1/:path*",
      "destination": "/api/v1?path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/finance(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
