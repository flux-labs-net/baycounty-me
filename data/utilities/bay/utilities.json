  {"area": "mb", "service": "water", "provider": "City of Mexico Beach", "entity_id": "gov:mb", "provider_kind": "City utility (water and treatment from Bay County)", "coverage": "all", "phone": "850-648-5700", "website": "https://mexicobeachfl.gov/?p=119", "outage_url": null, "notes": "7% utility tax on water.", "source_url": "https://mexicobeachfl.gov/?p=119"},
