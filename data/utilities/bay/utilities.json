  {"area": "cw", "service": "garbage", "provider": "A private hauler (Bargain Sanitation serves Callaway)", "entity_id": "vendor:bargain-sanitation", "entity_name": "Bargain Sanitation", "provider_kind": "Private hauler", "coverage": "all", "phone": "(850) 871-0016", "website": "https://www.baycountyfl.gov/DocumentCenter/View/19009/Solid-Waste-Haulers---Bay-County-updated-11-12-25", "outage_url": null, "notes": "The City of Callaway doesn't collect household garbage. The county's hauler list names Bargain Sanitation for Callaway; other licensed haulers can serve you too.", "source_url": "https://www.baycountyfl.gov/DocumentCenter/View/19009/Solid-Waste-Haulers---Bay-County-updated-11-12-25"},
  {"area": "cw", "service": "yard_waste", "provider": "City of Callaway Public Works", "entity_id": "gov:cw", "provider_kind": "City service", "coverage": "all", "phone": "850-871-1033", "website": "https://www.cityofcallaway.com/84/Solid-Waste-Division", "outage_url": null, "notes": "Weekly pickup of yard waste, bulk items and other trash too big for a 96-gallon can, on your zone's day. Out no earlier than the day before; yard waste and trash in separate piles; up to 6 x 4 x 4 feet (1,000 pounds) a week. Appliances need doors and Freon removed.", "source_url": "https://www.cityofcallaway.com/215/Trash-Yard-Waste-Information-PDF"},

