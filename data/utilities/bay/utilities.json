  {"area": "all", "service": "electric", "provider": "Florida Power & Light (FPL)", "entity_id": "vendor:fpl", "provider_kind": "Investor-owned utility, regulated by the Florida Public Service Commission", "coverage": "most", "phone": "1-800-468-8243", "website": "https://www.fpl.com/", "outage_url": "https://www.fpl.com/outage.html", "notes": "Serves most of Bay County, including the cities. FPL took over Gulf Power's Northwest Florida customers in 2022. Phone is FPL's outage line (1-800-4-OUTAGE).", "source_url": "https://floridapsc.com/library/filings/2025/04200-2025/04200-2025.pdf"},
  {"area": "all", "service": "electric", "provider": "Gulf Coast Electric Cooperative", "entity_id": "vendor:gulf-coast-electric-cooperative", "entity_name": "Gulf Coast Electric Cooperative", "provider_kind": "Member-owned electric cooperative", "coverage": "some", "phone": "(850) 639-2216", "website": "https://www.gcec.com/", "outage_url": "https://www.gcec.com/", "notes": "Serves parts of Bay County, mostly the north and east: Southport, Fountain and parts of Lynn Haven, plus Tyndall Air Force Base. Co-op and FPL lines can run through the same neighborhood, so your bill is the sure answer.", "source_url": "https://www.floridapsc.com/pscfiles/website-files/PDF/Utilities/Electricgas/EnergyInfrastructureStormHardening/UtilityFilings/2024/Rural%20Electric%20Cooperative%20Utility%20Storm%20Hardening%20Reports/Gulf%20Coast%20Electric%20Cooperative.pdf"},
  {"area": "all", "service": "gas", "provider": "Peoples Gas", "entity_id": "vendor:peoples-gas", "entity_name": "Peoples Gas", "provider_kind": "Natural gas utility, regulated by the Florida Public Service Commission", "coverage": "some", "phone": "(877) 832-6747", "website": "https://www.peoplesgas.com/", "outage_url": "https://www.peoplesgas.com/company/ournaturalgassystem/naturalgasoutages/", "notes": "Natural gas where its lines run, in every Bay County city and parts of the unincorporated county. Many homes have no gas line; propane comes from private dealers. If you smell gas, leave and call 911 or the number here.", "source_url": "https://www.peoplesgas.com/48ccab/siteassets/files/tariffpgs/tariffsection62.pdf"},
  {"area": "all", "service": "internet", "provider": "Private internet providers", "entity_id": null, "provider_kind": "Private companies (cable, fiber, wireless, satellite)", "coverage": "varies", "phone": null, "website": "https://broadbandmap.fcc.gov/home", "outage_url": null, "notes": "No local government sells internet here. The FCC's National Broadband Map lists the companies that report service at each address and their speeds.", "source_url": "https://broadbandmap.fcc.gov/home"},
  {"area": "all", "service": "recycling", "provider": "No public recycling program", "entity_id": null, "provider_kind": null, "coverage": "all", "phone": "850-236-2212", "website": "https://www.baycountyfl.gov/728/Recycling-in-Bay-County", "outage_url": null, "notes": "Bay County's recycling program closed after Hurricane Michael (2018) and no city runs curbside recycling. The county keeps a list of private recycling outlets. Batteries, paint, oil and other household hazardous waste go free to the Steelfield Road Landfill.", "source_url": "https://www.baycountyfl.gov/728/Recycling-in-Bay-County"},

  {"area": "county", "service": "water", "provider": "Bay County Utility Services", "entity_id": "gov:county", "provider_kind": "County utility", "coverage": "some", "phone": null, "website": "https://www.baycountyfl.gov/m/directory/department?did=19", "outage_url": null, "notes": "Retail water where the county runs the lines. Parts of the unincorporated county get city water from Panama City or Panama City Beach instead, and many rural homes are on a private well.", "source_url": "https://www.baycountyfl.gov/DocumentCenter/View/16599/Utilities-FY-25-Fees-and-Fines"},
  {"area": "county", "service": "water", "provider": "City of Panama City Utilities", "entity_id": "gov:pc", "provider_kind": "City utility", "coverage": "some", "phone": "850-872-3166", "website": "https://www.panamacity.gov/141/Utilities-Division", "outage_url": null, "notes": "Panama City's utility also serves parts of the unincorporated county next to the city.", "source_url": "https://www.panamacity.gov/141/Utilities-Division"},
  {"area": "county", "service": "sewer", "provider": "Bay County Utility Services", "entity_id": "gov:county", "provider_kind": "County utility", "coverage": "some", "phone": null, "website": "https://www.baycountyfl.gov/m/directory/department?did=19", "outage_url": null, "notes": "Where the county has sewer lines. Many unincorporated homes are on a septic tank instead.", "source_url": "https://www.baycountyfl.gov/DocumentCenter/View/16599/Utilities-FY-25-Fees-and-Fines"},
  {"area": "county", "service": "sewer", "provider": "City of Panama City Utilities", "entity_id": "gov:pc", "provider_kind": "City utility", "coverage": "some", "phone": "850-872-3166", "website": "https://www.panamacity.gov/141/Utilities-Division", "outage_url": null, "notes": "Parts of the unincorporated county next to Panama City.", "source_url": "https://www.panamacity.gov/141/Utilities-Division"},
  {"area": "county", "service": "garbage", "provider": "A private hauler you choose", "entity_id": null, "provider_kind": "Private licensed haulers", "coverage": "all", "phone": "850-236-2212", "website": "https://www.baycountyfl.gov/DocumentCenter/View/19009/Solid-Waste-Haulers---Bay-County-updated-11-12-25", "outage_url": null, "notes": "Bay County doesn't collect household garbage outside the cities. You sign up with a licensed hauler, which sets your pickup day. Licensed haulers include Waste Pro (850-872-1800), Waste Management (850-874-1019), K. C. Disposal (850-819-0575), Coastal Waste & Recycling (850-769-4304), BCC Waste Solutions (850-238-3609) and Coqui Disposal (850-257-5939). You can also haul it yourself to the Steelfield Road Landfill or the Bayline Drive drop-off center ($5 minimum).", "source_url": "https://www.baycountyfl.gov/DocumentCenter/View/19009/Solid-Waste-Haulers---Bay-County-updated-11-12-25"},
  {"area": "county", "service": "yard_waste", "provider": "No county pickup", "entity_id": null, "provider_kind": null, "coverage": "all", "phone": "850-236-2212", "website": "https://www.baycountyfl.gov/DocumentCenter/View/17301/Solid-Waste-Disposal-Guide-Pamphlet-2025-updated-4-9-25", "outage_url": null, "notes": "Take yard debris to the Steelfield Road Landfill ($38.19 a ton, $5 minimum in 2025) or ask your hauler. The landfill waives fees for residential trash, appliances and trees on Waste Amnesty Days each spring and fall.", "source_url": "https://www.baycountyfl.gov/DocumentCenter/View/17301/Solid-Waste-Disposal-Guide-Pamphlet-2025-updated-4-9-25"},

  {"area": "pc", "service": "water", "provider": "City of Panama City Utilities", "entity_id": "gov:pc", "provider_kind": "City utility", "coverage": "all", "phone": "850-872-3166", "website": "https://www.panamacity.gov/141/Utilities-Division", "outage_url": null, "notes": "Start, stop or move service through Utility Billing. New rates start with October 2026 usage.", "source_url": "https://www.panamacity.gov/141/Utilities-Division"},
  {"area": "pc", "service": "sewer", "provider": "City of Panama City Utilities", "entity_id": "gov:pc", "provider_kind": "City utility", "coverage": "all", "phone": "850-872-3166", "website": "https://www.panamacity.gov/141/Utilities-Division", "outage_url": null, "notes": null, "source_url": "https://www.panamacity.gov/141/Utilities-Division"},
  {"area": "pc", "service": "garbage", "provider": "City of Panama City Environmental Services", "entity_id": "gov:pc", "provider_kind": "City service, billed on the utility bill", "coverage": "all", "phone": "850-872-3172", "website": "https://www.panamacity.gov/154/Environmental-Services-Division-Solid-Wa", "outage_url": null, "notes": "One blue 96-gallon cart, picked up twice a week starting at 5 a.m. Put it out the night before or by 5 a.m., lid closed, within two feet of the road. Text PCgarbage to 38276 for schedule changes.", "source_url": "https://www.panamacity.gov/154/Environmental-Services-Division-Solid-Wa"},
  {"area": "pc", "service": "yard_waste", "provider": "City of Panama City Environmental Services", "entity_id": "gov:pc", "provider_kind": "City service", "coverage": "all", "phone": "850-872-3172", "website": "https://www.panamacity.gov/154/Environmental-Services-Division-Solid-Wa", "outage_url": null, "notes": "Yard waste and limited bulk items once a week, starting at 6 a.m. Up to 4 x 6 x 6 feet a week; limbs under 4 feet long and 4 inches across. The day comes from the city's map and can vary with volume. No dirt, concrete, tires or hazardous waste.", "source_url": "https://www.panamacity.gov/154/Environmental-Services-Division-Solid-Wa"},

  {"area": "pcb", "service": "water", "provider": "City of Panama City Beach Utilities", "entity_id": "gov:pcb", "provider_kind": "City utility", "coverage": "all", "phone": "(850) 233-5100", "website": "https://www.pcbfl.gov/", "outage_url": null, "notes": "Monthly base charges include 6,000 gallons.", "source_url": "https://www.pcbfl.gov/DocumentCenter/View/3907/CityRateSheet-2026"},
