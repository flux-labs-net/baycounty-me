  {"area": "pcb", "service": "garbage", "provider": "A private hauler you choose", "entity_id": null, "provider_kind": "Private licensed haulers", "coverage": "all", "phone": "(850) 233-5100", "website": "https://www.baycountyfl.gov/DocumentCenter/View/19009/Solid-Waste-Haulers---Bay-County-updated-11-12-25", "outage_url": null, "notes": "Household garbage in Panama City Beach is picked up by private haulers, which set the day. See the county's list of licensed haulers.", "source_url": "https://www.baycountyfl.gov/DocumentCenter/View/19009/Solid-Waste-Haulers---Bay-County-updated-11-12-25"},
  {"area": "pcb", "service": "yard_waste", "provider": "City of Panama City Beach Street Division", "entity_id": "gov:pcb", "provider_kind": "City service", "coverage": "all", "phone": "(850) 233-5100", "website": "https://www.pcbfl.gov/403/Yard-Debris", "outage_url": null, "notes": "Yard debris from homes inside the city limits, on a rolling route (three trucks); you can't call to schedule a pickup. Not for businesses, condos, apartments, landscapers or lot clearing.", "source_url": "https://www.pcbfl.gov/403/Yard-Debris"},
  {"area": "pcb", "service": "bulk", "provider": "City of Panama City Beach Street Division", "entity_id": "gov:pcb", "provider_kind": "City service", "coverage": "all", "phone": "(850) 233-5100", "website": "https://www.pcbfl.gov/405/Bulk-Waste-Pilot-Program", "outage_url": null, "notes": "Free bulk pickup twice a year for houses (not condos, apartments or businesses), out by 7 a.m. In 2026: east of Nautilus Street April 13 and September 14; west of Nautilus Street April 20 and September 21.", "source_url": "https://www.pcbfl.gov/405/Bulk-Waste-Pilot-Program"},

