  {"area": "sp", "service": "garbage", "provider": "Waste Pro (under contract with the City of Springfield)", "entity_id": "vendor:waste-pro", "provider_kind": "Private hauler under city contract, billed by the city", "coverage": "all", "phone": "(850) 872-1800", "website": "https://www.springfieldfl.net/publicworks/page/sanitation-service-information", "outage_url": null, "notes": "Put the cart at the street the night before; Waste Pro starts very early and won't come back. Call Waste Pro for your pickup day. Problems: City of Springfield, 850-872-7570 ext. 109.", "source_url": "https://www.springfieldfl.net/publicworks/page/sanitation-service-information"},
  {"area": "sp", "service": "yard_waste", "provider": "Waste Pro (under contract with the City of Springfield)", "entity_id": "vendor:waste-pro", "provider_kind": "Private hauler under city contract", "coverage": "all", "phone": "(850) 872-1800", "website": "https://www.springfieldfl.net/publicworks/page/sanitation-service-information", "outage_url": null, "notes": "Yard debris and bulk household items usually go the same day as your garbage. Limbs under 8 feet long and 8 inches across. No construction debris.", "source_url": "https://www.springfieldfl.net/publicworks/page/sanitation-service-information"},

