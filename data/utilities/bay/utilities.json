  {"area": "lh", "service": "garbage", "provider": "City of Lynn Haven Sanitation", "entity_id": "gov:lh", "provider_kind": "City service, billed on the water bill", "coverage": "all", "phone": "850-265-5989", "website": "https://www.cityoflynnhaven.gov/174/Garbage-Trash", "outage_url": null, "notes": "City cart only. Put it out after 6 p.m. the night before and by 6 a.m., within 2 feet of the road, handle toward the house; bring it in by 9 a.m. the next day. An extra cart is $3.22 a month.", "source_url": "https://www.cityoflynnhaven.gov/174/Garbage-Trash"},
  {"area": "lh", "service": "yard_waste", "provider": "City of Lynn Haven Sanitation", "entity_id": "gov:lh", "provider_kind": "City service", "coverage": "all", "phone": "850-265-5989", "website": "https://www.cityoflynnhaven.gov/174/Garbage-Trash", "outage_url": null, "notes": "Weekly yard trash: limbs under 4 inches across and 4 feet long, one pile up to 2 cubic yards, never in a garbage cart. Call to schedule couches, mattresses or appliances (fee added to the water bill).", "source_url": "https://www.cityoflynnhaven.gov/174/Garbage-Trash"},

