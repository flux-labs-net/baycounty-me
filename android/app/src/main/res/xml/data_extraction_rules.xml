<?xml version="1.0" encoding="utf-8"?>
<!-- The My home sign-in token stays on this phone: it isn't copied to backups or to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="account.xml" />
    </device-transfer>
</data-extraction-rules>
