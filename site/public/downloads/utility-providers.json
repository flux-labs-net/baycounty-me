2026-10-27","source_url":"https://www.springfieldfl.net/publicworks/page/sanitation-service-information"},{"place_id":"fl-bay","area":"sp","area_name":"Springfield","gov_id":"sp","service":"yard_waste","service_label":"Yard waste and bulk trash","provider":"Waste Pro (under contract with the City of Springfield)","entity_id":"vendor:waste-pro","entity_name":null,"provider_kind":"Private hauler under city contract","coverage":"all","phone":"(850) 872-1800","website":"https://www.springfieldfl.net/publicworks/page/sanitation-service-information","outage_url":null,"notes":"Yard debris and bulk household items usually go the same day as your garbage. Limbs under 8 feet long and 8 inches across. No construction debris.","as_of":"2026-10-27","source_url":"https://www.springfieldfl.net/publicworks/page/sanitation-service-information"},{"place_id":"fl-bay","area":"parker","area_name":"Parker","gov_id":"parker","service":"water","service_label":"Water","provider":"City of Parker Utilities","entity_id":"gov:parker","entity_name":null,"provider_kind":"City utility (water bought wholesale from Bay County)","coverage":"all","phone":"(850) 871-4949","website":"https://www.cityofparker.com/","outage_url":null,"notes":"Rates rise 3% every October 1 and follow any Bay County wholesale increase.","as_of":"2026-10-27","source_url":"https://cityofparker.com/wp-content/uploads/filr/6076/Ordinance-2025-425.pdf"},{"place_id":"fl-bay","area":"parker","area_name":"Parker","gov_id":"parker","service":"sewer","service_label":"Sewer","provider":"City of Parker Utilities","entity_id":"gov:parker","entity_name":null,"provider_kind":"City utility","coverage":"all","phone":"(850) 871-4949","website":"https://www.cityofparker.com/","outage_url":null,"notes":"Parker's sewer rate schedule wasn't found online.","as_of":"2026-10-27","source_url":"https://cityofparker.com/wp-content/uploads/filr/6076/Ordinance-2025-425.pdf"},{"place_id":"fl-bay","area":"parker","area_name":"Parker","gov_id":"parker","service":"garbage","service_label":"Garbage","provider":"A private hauler you choose","entity_id":null,"entity_name":null,"provider_kind":"Private licensed haulers","coverage":"all","phone":"(850) 871-4104","website":"https://www.baycountyfl.gov/DocumentCenter/View/19009/Solid-Waste-Haulers---Bay-County-updated-11-12-25","outage_url":null,"notes":"The City of Parker doesn't pick up household garbage; private haulers do.","as_of":"2026-10-27","source_url":"https://www.cityofparker.com/departments/public-works/bulk-trash/"},{"place_id":"fl-bay","area":"parker","area_name":"Parker","gov_id":"parker","service":"yard_waste","service_label":"Yard waste and bulk trash","provider":"City of Parker Public Works","entity_id":"gov:parker","entity_name":null,"provider_kind":"City service ($14.50 a month)","coverage":"all","phone":"(850) 871-4104 ext. 1132","website":"https://www.cityofparker.com/departments/public-works/bulk-trash/","outage_url":null,"notes":"Yard debris and bulk items at the roadside, weekly on your zone's day. Each pile up to 4 x 4 x 6 feet; bigger piles are hauled at your cost.","as_of":"2026-10-27","source_url":"https://www.cityofparker.com/departments/public-works/bulk-trash/"},{"place_id":"fl-bay","area":"mb","area_name":"Mexico Beach","gov_id":"mb","service":"water","service_label":"Water","provider":"City of Mexico Beach","entity_id":"gov:mb","entity_name":null,"provider_kind":"City utility (water and treatment from Bay County)","coverage":"all","phone":"850-648-5700","website":"https://mexicobeachfl.gov/?p=119","outage_url":null,"notes":"7% utility tax on water.","as_of":"2026-10-27","source_url":"https://mexicobeachfl.gov/?p=119"},{"place_id":"fl-bay","area":"mb","area_name":"Mexico Beach","gov_id":"mb","service":"sewer","service_label":"Sewer","provider":"City of Mexico Beach","entity_id":"gov:mb","entity_name":null,"provider_kind":"City utility","coverage":"all","phone":"850-648-5700","website":"https://mexicobeachfl.gov/?p=119","outage_url":null,"note