[{"place_id":"fl-bay","area":"all","area_name":"All of Bay County","gov_id":null,"service":"electric","service_label":"Electricity","provider":"Florida Power & Light (FPL)","entity_id":"vendor:fpl","entity_name":null,"provider_kind":"Investor-owned utility, regulated by the Florida Public Service Commission","coverage":"most","phone":"1-800-468-8243","website":"https://www.fpl.com/","outage_url":"https://www.fpl.com/outage.html","notes":"Serves most of Bay County, including the cities. FPL took over Gulf Power's Northwest Florida customers in 2022. Phone is FPL's outage line (1-800-4-OUTAGE).","as_of":"2026-10-27","source_url":"https://floridapsc.com/library/filings/2025/04200-2025/04200-2025.pdf"},{"place_id":"fl-bay","area":"all","area_name":"All of Bay County","gov_id":null,"service":"electric","service_label":"Electricity","provider":"Gulf Coast Electric Cooperative","entity_id":"vendor:gulf-coast-electric-cooperative","entity_name":"Gulf Coast Electric Cooperative","provider_kind":"Member-owned electric cooperative","coverage":"some","phone":"(850) 639-2216","website":"https://www.gcec.com/","outage_url":"https://www.gcec.com/","notes":"Serves parts of Bay County, mostly the north and east: Southport, Fountain and parts of Lynn Haven, plus Tyndall Air Force Base. Co-op and FPL lines can run through the same neighborhood, so your bill is the sure answer.","as_of":"2026-10-27","source_url":"https://www.floridapsc.com/pscfiles/website-files/PDF/Utilities/Electricgas/EnergyInfrastructureStormHardening/UtilityFilings/2024/Rural%20Electric%20Cooperative%20Utility%20Storm%20Hardening%20Reports/Gulf%20Coast%20Electric%20Cooperative.pdf"},{"place_id":"fl-bay","area":"all","area_name":"All of Bay County","gov_id":null,"service":"gas","service_label":"Natural gas","provider":"Peoples Gas","entity_id":"vendor:peoples-gas","entity_name":"Peoples Gas","provider_kind":"Natural gas utility, regulated by the Florida Public Service Commission","coverage":"some","phone":"(877) 832-6747","website":"https://www.peoplesgas.com/","outage_url":"https://www.peoplesgas.com/company/ournaturalgassystem/naturalgasoutages/","notes":"Natural gas where its lines run, in every Bay County city and parts of the unincorporated county. Many homes have no gas line; propane comes from private dealers. If you smell gas, leave and call 911 or the number here.","as_of":"2026-10-27","source_url":"https://www.peoplesgas.com/48ccab/siteassets/files/tariffpgs/tariffsection62.pdf"},{"place_id":"fl-bay","area":"all","area_name":"All of Bay County","gov_id":null,"service":"internet","service_label":"Internet","provider":"Private internet providers","entity_id":null,"entity_name":null,"provider_kind":"Private companies (cable, fiber, wireless, satellite)","coverage":"varies","phone":null,"website":"https://broadbandmap.fcc.gov/home","outage_url":null,"notes":"No local government sells internet here. The FCC's National Broadband Map lists the companies that report service at each address and their speeds.","as_of":"2026-10-27","source_url":"https://broadbandmap.fcc.gov/home"},{"place_id":"fl-bay","area":"all","area_name":"All of Bay County","gov_id":null,"service":"recycling","service_label":"Recycling","provider":"No public recycling program","entity_id":null,"entity_name":null,"provider_kind":null,"coverage":"all","phone":"850-236-2212","website":"https://www.baycountyfl.gov/728/Recycling-in-Bay-County","outage_url":null,"notes":"Bay County's recycling program closed after Hurricane Michael (2018) and no city runs curbside recycling. The county keeps a list of private recycling outlets. Batteries, paint, oil and other household hazardous waste go free to the Steelfield Road Landfill.","as_of":"2026-10-27","source_url":"https://www.baycountyfl.gov/728/Recycling-in-Bay-County"},{"place_id":"fl-bay","area":"county","area_name":"Unincorporated Bay County","gov_id":"county","service":"water","service_label":"Water","provider":"Bay County Utility Services","entity_id":"gov:county","entity_name":null,"provider_kind":"County utility","coverage":"some","phone":null,"website":"https://www.baycountyfl.gov/m/directory/department?did=19","outage_url":null,"notes":"Retail water where the county runs the lines. Parts of the unincorporated county get city water from Panama City or Panama City Beach instead, and many rural homes are on a private well.","as_of":"2026-10-27","source_url":"https://www.baycountyfl.gov/DocumentCenter/View/16599/Utilities-FY-25-Fees-and-Fines"},{"place_id":"fl-bay","area":"county","area_name":"Unincorporated Bay County","gov_id":"county","service":"water","service_label":"Water","provider":"City of Panama City Utilities","entity_id":"gov:pc","entity_name":null,"provider_kind":"City utility","coverage":"some","phone":"850-872-3166","website":"https://www.panamacity.gov/141/Utilities-Division","outage_url":null,"notes":"Panama City's utility also serves parts of the unincorporated county next to the city.","as_of":"2026-10-27","source_url":"https://www.panamacity.gov/141/Utilities-Division"},{"place_id":"fl-bay","area":"county","area_name":"Unincorporated Bay County","gov_id":"county","service":"sewer","service_label":"Sewer","provider":"Bay County Utility Services","entity_id":"gov:county","entity_name":null,"provider_kind":"County utility","coverage":"some","phone":null,"website":"https://www.baycountyfl.gov/m/directory/department?did=19","outage_url":null,"notes":"Where the county has sewer lines. Many unincorporated homes are on a septic tank instead.","as_of":"2026-10-27","source_url":"https://www.baycountyfl.gov/DocumentCenter/View/16599/Utilities-FY-25-Fees-and-Fines"},{"place_id":"fl-bay","area":"county","area_name":"Unincorporated Bay County","gov_id":"county","service":"sewer","service_label":"Sewer","provider":"City of Panama City Utilities","entity_id":"gov:pc","entity_name":null,"provider_kind":"City utility","coverage":"some","phone":"850-872-3166","website":"https://www.panamacity.gov/141/Utilities-Division","outage_url":null,"notes":"Parts of the unincorporated county next to Panama City.","as_of":"2026-10-27","source_url":"https://www.panamacity.gov/141/Utilities-Division"},{"place_id":"fl-bay","area":"county","area_name":"Unincorporated Bay County","gov_id":"county","service":"garbage","service_label":"Garbage","provider":"A private hauler you choose","entity_id":null,"entity_name":null,"provider_kind":"Private licensed haulers","coverage":"all","phone":"850-236-2212","website":"https://www.baycountyfl.gov/DocumentCenter/View/19009/Solid-Waste-Haulers---Bay-County-updated-11-12-25","outage_url":null,"notes":"Bay County doesn't collect household garbage outside the cities. You sign up with a licensed hauler, which sets your pickup day. Licensed haulers include Waste Pro (850-872-1800), Waste Management (850-874-1019), K. C. Disposal (850-819-0575), Coastal Waste & Recycling (850-769-4304), BCC Waste Solutions (850-238-3609) and Coqui Disposal (850-257-5939). You can also haul it yourself to the Steelfield Road Landfill or the Bayline Drive drop-off center ($5 minimum).","as_of":"2026-10-27","source_url":"https://www.baycountyfl.gov/DocumentCenter/View/19009/Solid-Waste-Haulers---Bay-County-updated-11-12-25"},{"place_id":"fl-bay","area":"county","area_name":"Unincorporated Bay County","gov_id":"county","service":"yard_waste","service_label":"Yard waste and bulk trash","provider":"No county pickup","entity_id":null,"entity_name":null,"provider_kind":null,"coverage":"all","phone":"850-236-2212","website":"https://www.baycountyfl.gov/DocumentCenter/View/17301/Solid-Waste-Disposal-Guide-Pamphlet-2025-updated-4-9-25","outage_url":null,"notes":"Take yard debris to the Steelfield Road Landfill ($38.19 a ton, $5 minimum in 2025) or ask your hauler. The landfill waives fees for residential trash, appliances and trees on Waste Amnesty Days each spring and fall.","as_of":"2026-10-27","source_url":"https://www.baycountyfl.gov/DocumentCenter/View/17301/Solid-Waste-Disposal-Guide-Pamphlet-2025-updated-4-9-25"},{"place_id":"fl-bay","area":"pc","area_name":"Panama City","gov_id":"pc","service":"water","service_label":"Water","provider":"City of Panama City Utilities","entity_id":"gov:pc","entity_name":null,"provider_kind":"City utility","coverage":"all","phone":"850-872-3166","website":"https://www.panamacity.gov/141/Utilities-Division","outage_url":null,"notes":"Start, stop or move service through Utility Billing. New rates start with October 2026 usage.","as_of":"2026-10-27","source_url":"https://www.panamacity.gov/141/Utilities-Division"},{"place_id":"fl-bay","area":"pc","area_name":"Panama City","gov_id":"pc","service":"sewer","service_label":"Sewer","provider":"City of Panama City Utilities","entity_id":"gov:pc","entity_name":null,"provider_kind":"City utility","coverage":"all","phone":"850-872-3166","website":"https://www.panamacity.gov/141/Utilities-Division","outage_url":null,"notes":null,"as_of":"2026-10-27","source_url":"https://www.panamacity.gov/141/Utilities-Division"},{"place_id":"fl-bay","area":"pc","area_name":"Panama City","gov_id":"pc","service":"garbage","service_label":"Garbage","provider":"City of Panama City Environmental Services","entity_id":"gov:pc","entity_name":null,"provider_kind":"City service, billed on the utility bill","coverage":"all","phone":"850-872-3172","website":"https://www.panamacity.gov/154/Environmental-Services-Division-Solid-Wa","outage_url":null,"notes":"One blue 96-gallon cart, picked up twice a week starting at 5 a.m. Put it out the night before or by 5 a.m., lid closed, within two feet of the road. Text PCgarbage to 38276 for schedule changes.","as_of":"2026-10-27","source_url":"https://www.panamacity.gov/154/Environmental-Services-Division-Solid-Wa"},{"place_id":"fl-bay","area":"pc","area_name":"Panama City","gov_id":"pc","service":"yard_waste","service_label":"Yard waste and bulk trash","provider":"City of Panama City Environmental Services","entity_id":"gov:pc","entity_name":null,"provider_kind":"City service","coverage":"all","phone":"850-872-3172","website":"https://www.panamacity.gov/154/Environmental-Services-Division-Solid-Wa","outage_url":null,"notes":"Yard waste and limited bulk items once a week, starting at 6 a.m. Up to 4 x 6 x 6 feet a week; limbs under 4 feet long and 4 inches across. The day comes from the city's map and can vary with volume. No dirt, concrete, tires or hazardous waste.","as_of":"2026-10-27","source_url":"https://www.panamacity.gov/154/Environmental-Services-Division-Solid-Wa"},{"place_id":"fl-bay","area":"pcb","area_name":"Panama City Beach","gov_id":"pcb","service":"water","service_label":"Water","provider":"City of Panama City Beach Utilities","entity_id":"gov:pcb","entity_name":null,"provider_kind":"City utility","coverage":"all","phone":"(850) 233-5100","website":"https://www.pcbfl.gov/","outage_url":null,"notes":"Monthly base charges include 6,000 gallons.","as_of":"2026-10-27","source_url":"https://www.pcbfl.gov/DocumentCenter/View/3907/CityRateSheet-2026"},{"place_id":"fl-bay","area":"pcb","area_name":"Panama City Beach","gov_id":"pcb","service":"sewer","service_label":"Sewer","provider":"City of Panama City Beach Utilities","entity_id":"gov:pcb","entity_name":null,"provider_kind":"City utility","coverage":"all","phone":"(850) 233-5100","website":"https://www.pcbfl.gov/","outage_url":null,"notes":null,"as_of":"2026-10-27","source_url":"https://www.pcbfl.gov/DocumentCenter/View/3907/CityRateSheet-2026"},{"place_id":"fl-bay","area":"pcb","area_name":"Panama City Beach","gov_id":"pcb","service":"garbage","service_label":"Garbage","provider":"A private hauler you choose","entity_id":null,"entity_name":null,"provider_kind":"Private licensed haulers","coverage":"all","phone":"(850) 233-5100","website":"https://www.baycountyfl.gov/DocumentCenter/View/19009/Solid-Waste-Haulers---Bay-County-updated-11-12-25","outage_url":null,"notes":"Household garbage in Panama City Beach is picked up by private haulers, which set the day. See the county's list of licensed haulers.","as_of":"2026-10-27","source_url":"https://www.baycountyfl.gov/DocumentCenter/View/19009/Solid-Waste-Haulers---Bay-County-updated-11-12-25"},{"place_id":"fl-bay","area":"pcb","area_name":"Panama City Beach","gov_id":"pcb","service":"yard_waste","service_label":"Yard waste and bulk trash","provider":"City of Panama City Beach Street Division","entity_id":"gov:pcb","entity_name":null,"provider_kind":"City service","coverage":"all","phone":"(850) 233-5100","website":"https://www.pcbfl.gov/403/Yard-Debris","outage_url":null,"notes":"Yard debris from homes inside the city limits, on a rolling route (three trucks); you can't call to schedule a pickup. Not for businesses, condos, apartments, landscapers or lot clearing.","as_of":"2026-10-27","source_url":"https://www.pcbfl.gov/403/Yard-Debris"},{"place_id":"fl-bay","area":"pcb","area_name":"Panama City Beach","gov_id":"pcb","service":"bulk","service_label":"Bulk pickup","provider":"City of Panama City Beach Street Division","entity_id":"gov:pcb","entity_name":null,"provider_kind":"City service","coverage":"all","phone":"(850) 233-5100","website":"https://www.pcbfl.gov/405/Bulk-Waste-Pilot-Program","outage_url":null,"notes":"Free bulk pickup twice a year for houses (not condos, apartments or businesses), out by 7 a.m. In 2026: east of Nautilus Street April 13 and September 14; west of Nautilus Street April 20 and September 21.","as_of":"2026-10-27","source_url":"https://www.pcbfl.gov/405/Bulk-Waste-Pilot-Program"},{"place_id":"fl-bay","area":"lh","area_name":"Lynn Haven","gov_id":"lh","service":"water","service_label":"Water","provider":"City of Lynn Haven Utilities","entity_id":"gov:lh","entity_name":null,"provider_kind":"City utility","coverage":"all","phone":null,"website":"https://www.cityoflynnhaven.gov/","outage_url":null,"notes":null,"as_of":"2026-10-27","source_url":"https://cityoflynnhaven.com/DocumentCenter/View/4411"},{"place_id":"fl-bay","area":"lh","area_name":"Lynn Haven","gov_id":"lh","service":"sewer","service_label":"Sewer","provider":"City of Lynn Haven Utilities","entity_id":"gov:lh","entity_name":null,"provider_kind":"City utility","coverage":"all","phone":null,"website":"https://www.cityoflynnhaven.gov/","outage_url":null,"notes":"Residential sewer usage is capped at 12,000 gallons a month.","as_of":"2026-10-27","source_url":"https://cityoflynnhaven.com/DocumentCenter/View/4411"},{"place_id":"fl-bay","area":"lh","area_name":"Lynn Haven","gov_id":"lh","service":"garbage","service_label":"Garbage","provider":"City of Lynn Haven Sanitation","entity_id":"gov:lh","entity_name":null,"provider_kind":"City service, billed on the water bill","coverage":"all","phone":"850-265-5989","website":"https://www.cityoflynnhaven.gov/174/Garbage-Trash","outage_url":null,"notes":"City cart only. Put it out after 6 p.m. the night before and by 6 a.m., within 2 feet of the road, handle toward the house; bring it in by 9 a.m. the next day. An extra cart is $3.22 a month.","as_of":"2026-10-27","source_url":"https://www.cityoflynnhaven.gov/174/Garbage-Trash"},{"place_id":"fl-bay","area":"lh","area_name":"Lynn Haven","gov_id":"lh","service":"yard_waste","service_label":"Yard waste and bulk trash","provider":"City of Lynn Haven Sanitation","entity_id":"gov:lh","entity_name":null,"provider_kind":"City service","coverage":"all","phone":"850-265-5989","website":"https://www.cityoflynnhaven.gov/174/Garbage-Trash","outage_url":null,"notes":"Weekly yard trash: limbs under 4 inches across and 4 feet long, one pile up to 2 cubic yards, never in a garbage cart. Call to schedule couches, mattresses or appliances (fee added to the water bill).","as_of":"2026-10-27","source_url":"https://www.cityoflynnhaven.gov/174/Garbage-Trash"},{"place_id":"fl-bay","area":"cw","area_name":"Callaway","gov_id":"cw","service":"water","service_label":"Water","provider":"City of Callaway Utility Billing","entity_id":"gov:cw","entity_name":null,"provider_kind":"City utility (water bought wholesale from Bay County)","coverage":"all","phone":"(850) 871-1033","website":"https://www.cityofcallaway.com/102/Rates","outage_url":null,"notes":"Some Callaway parcels are on private utilities.","as_of":"2026-10-27","source_url":"https://www.cityofcallaway.com/102/Rates"},{"place_id":"fl-bay","area":"cw","area_name":"Callaway","gov_id":"cw","service":"sewer","service_label":"Sewer","provider":"City of Callaway Utility Billing","entity_id":"gov:cw","entity_name":null,"provider_kind":"City utility (treatment bought from Bay County)","coverage":"all","phone":"(850) 871-1033","website":"https://www.cityofcallaway.com/102/Rates","outage_url":null,"notes":null,"as_of":"2026-10-27","source_url":"https://www.cityofcallaway.com/102/Rates"},{"place_id":"fl-bay","area":"cw","area_name":"Callaway","gov_id":"cw","service":"garbage","service_label":"Garbage","provider":"A private hauler (Bargain Sanitation serves Callaway)","entity_id":"vendor:bargain-sanitation","entity_name":"Bargain Sanitation","provider_kind":"Private hauler","coverage":"all","phone":"(850) 871-0016","website":"https://www.baycountyfl.gov/DocumentCenter/View/19009/Solid-Waste-Haulers---Bay-County-updated-11-12-25","outage_url":null,"notes":"The City of Callaway doesn't collect household garbage. The county's hauler list names Bargain Sanitation for Callaway; other licensed haulers can serve you too.","as_of":"2026-10-27","source_url":"https://www.baycountyfl.gov/DocumentCenter/View/19009/Solid-Waste-Haulers---Bay-County-updated-11-12-25"},{"place_id":"fl-bay","area":"cw","area_name":"Callaway","gov_id":"cw","service":"yard_waste","service_label":"Yard waste and bulk trash","provider":"City of Callaway Public Works","entity_id":"gov:cw","entity_name":null,"provider_kind":"City service","coverage":"all","phone":"850-871-1033","website":"https://www.cityofcallaway.com/84/Solid-Waste-Division","outage_url":null,"notes":"Weekly pickup of yard waste, bulk items and other trash too big for a 96-gallon can